{
  "title": "Munchi Wave",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "CHOMPI WAVE 1.0:",
        "8-voice wavetable",
        "synth with a",
        "32-step sequencer.",
        "",
        "Takes over Move.",
        "Back twice exits.",
        "",
        "Pads are two",
        "octaves of keys."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "Page 1:",
        "Table  Frame",
        "Filter Resonance",
        "Attack Release",
        "Space  Tempo",
        "",
        "Right, page 2:",
        "Pitch, LFO depth",
        "and rate x2,",
        "Delay time, Pan,",
        "Comp",
        "Vol: Volume"
      ]
    },
    {
      "title": "Sequencer",
      "lines": [
        "Loop: record.",
        "Play keys one at",
        "a time; each is",
        "a step.",
        "Sample: a rest.",
        "Loop: stop.",
        "Play: play/stop.",
        "",
        "Delete + Loop:",
        "clear."
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "Steps 1-14 or the",
        "jog: presets.",
        "Step 15: defaults.",
        "",
        "Save: hold Shift,",
        "A#4, pick a white",
        "key, Shift.",
        "G#4 copy, F#4",
        "erase."
      ]
    },
    {
      "title": "Shift Layer",
      "lines": [
        "C#3/D#3: octave",
        "F#3/G#3/A#3:",
        "gate 10/50/100%",
        "C#4: pitch LFO",
        "D#4: filter LFO",
        "",
        "Tracks 1-3: tap",
        "tempo, pitch LFO,",
        "filter LFO."
      ]
    },
    {
      "title": "Wavetables",
      "lines": [
        "UserLibrary/",
        "Samples/Schwung/",
        "Munchi Wave",
        "",
        "First 7 .wav",
        "files, A-Z.",
        "33 frames x 2048",
        "(Serum format)."
      ]
    }
  ]
}